# --- required ---
GEMINI_API_KEY=
# Shared secret the Stick sends as "Authorization: Bearer <token>". Must match firmware/src/secrets.h
KAI_DEVICE_TOKEN=change-me

# --- model / voice ---
KAI_MODEL=gemini-3.8-live
KAI_VOICE=Puck

# --- where "here" / "near me" means until the phone provides GPS ---
# e.g. Half Moon Bay: 37.4636, -122.4286 (nearest NOAA tide station: Pillar Point Harbor)
KAI_HOME_NAME=Home
KAI_HOME_LAT=
KAI_HOME_LON=

# imperial (ft, mph, F) or metric (m, km/h, C)
KAI_UNITS=imperial

# Optional: enables parking search and better place lookup (Places API (New) must be enabled)
GOOGLE_MAPS_API_KEY=

# --- server ---
KAI_HOST=0.0.0.0
KAI_PORT=8765
# SQLite + caches live here; notes are mirrored as Markdown into KAI_NOTES_DIR (point it at an Obsidian vault if you like)
KAI_DATA_DIR=./data
KAI_NOTES_DIR=./data/notes
# Close the Gemini session after this many idle seconds (resets conversation context, keeps costs down)
KAI_IDLE_CLOSE_S=300
