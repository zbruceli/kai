# --- required ---
GEMINI_API_KEY=

# --- model / voice ---
KAI_MODEL=gemini-3.8-live
KAI_VOICE=Puck

# --- where "here" / "near me" means until the phone provides GPS ---
# e.g. Half Moon Bay: 37.4636, -122.4286 (nearest NOAA tide station: Pillar Point Harbor)
KAI_HOME_NAME=Home
KAI_HOME_LAT=
KAI_HOME_LON=

# imperial (ft, mph, F) or metric (m, km/h, C)
KAI_UNITS=imperial

# Optional: enables parking search and better place lookup (Places API (New) must be enabled)
GOOGLE_MAPS_API_KEY=

# --- server ---
KAI_HOST=0.0.0.0
KAI_PORT=8765
# The encrypted link (TLS 1.2 ECDHE-PSK) on KAI_TLS_PORT. Sticks get their keys by pairing: a new Stick
# shows a 6-digit code, and `uv run kai-approve <code>` accepts it (KAI_PAIR_PORT; KAI_PAIRING=0 turns it off).
# KAI_TLS_PORT=8443
# KAI_PAIR_PORT=8444
# The relay announces itself on the LAN (mDNS `_kai._tcp`), so Sticks find it without an address:
# KAI_ANNOUNCE=1
# Keys made by hand with `uv run kai-psk <name>` ("name:hexkey", comma-separated) are imported once:
# KAI_DEVICE_PSKS=
# Plain ws:// on KAI_PORT is only for Sticks built with a token in secrets.h. It is unencrypted, so it is
# off unless a token is set; with one, it runs while no Stick has a key, or always with KAI_ALLOW_PLAIN_WS=1.
# KAI_DEVICE_TOKEN=
# KAI_ALLOW_PLAIN_WS=0
# SQLite + caches live here; notes are mirrored as Markdown into KAI_NOTES_DIR (point it at an Obsidian vault if you like)
KAI_DATA_DIR=./data
KAI_NOTES_DIR=./data/notes
# Close the Gemini session after this many idle seconds (resets conversation context, keeps costs down)
KAI_IDLE_CLOSE_S=300

# --- background brain (optional): Hermes Agent on this host; see deploy/hermes/README.md ---
# HERMES_URL=http://127.0.0.1:8642
# HERMES_API_KEY=
# KAI_MCP_PORT=8766
# KAI_MCP_TOKEN=
